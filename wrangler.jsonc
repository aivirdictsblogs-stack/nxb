{
  "name": "noorix-digital-lab",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sitemap.xml"]
  },
    "d1_databases": [{ "binding": "DB", "database_name": "noorix-db", "database_id": "84b01963-78c0-45ce-a418-bddcabdaec8a", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "noorix-uploads" }],
  "vars": { "APP_URL": "https://noorixdigitallab.online", "ENVIRONMENT": "production" }
}
