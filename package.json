{
  "name": "noorix-digital-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && wrangler deploy --dry-run --outdir dist-worker",
    "db:migrate:local": "wrangler d1 migrations apply noorix-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply noorix-db --remote",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "build:web": "vite build"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "wrangler": "^4.158.0"
  }
}